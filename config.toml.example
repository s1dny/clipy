# Copy to config.toml. Each channel's settings are [defaults] with
# [channels.<name>] on top; the agent's prompt overrides win over both.

[runtime]
ffmpeg_path = "ffmpeg"

[models]
clip = "z-ai/glm-5.3-flash"
image = "bytedance-seed/seedream-5-0-lite"
speech = "universal-3-5-pro"

[defaults]
description_template = """
{clip_description}

Original: {original_url}
"""

# {speaker} is the source's main speaker.
clip_extraction_prompt_template = """
Extract good standalone clips of {speaker} from this transcript.

Return JSON in this exact format:
{
  "clips": [
    {
      "title": "{speaker} on [subject]",
      "description": "Brief description for YouTube",
      "start_ms": 12345,
      "end_ms": 67890,
      "score": 7,
      "thumbnail_prompt": "Detailed prompt for generating a thumbnail image."
    }
  ]
}
"""

illustration_prompt_template = """
Create a simple illustration for a YouTube thumbnail about: {prompt}.
Use a pure WHITE background (#FFFFFF).
"""

# A channel about one person: a fixed speaker and thumbnail template (in
# ./thumbnails, a photo on the left and white on the right).
[channels.example]
handle = "@ExampleClips"
speaker = "Example Person"
thumbnail_template = "example.jpg"
category_id = "28"

# A channel of many speakers: thumbnails put each clip speaker's headshot
# (<data dir>/headshots/<name>.jpg, which the agent makes) on the left.
[channels.ideas]
handle = "@IdeasClips"
category_id = "27"

[channels.hotz]
handle = "@georgehotzclips"
speaker = "George Hotz"
thumbnail_template = "hotz.jpg"
category_id = "28"

description_template = """
{clip_description}

Clip from George Hotz
Original: {original_url}
Twitch: https://www.twitch.tv/georgehotz

#georgehotz #programming #ai #tinygrad
"""

clip_extraction_prompt_template = """
This is a transcript of an original long-form video featuring George Hotz, the programmer and hacker behind comma.ai and tinygrad.

Find strong standalone clips about AI, machine learning, programming, GPUs, software performance, hacking, self-driving technology, or building a technology company. Prefer one clear argument, a concrete explanation, or a demonstration that makes sense without the preceding stream. Skip unrelated politics, personal tangents, small talk, sponsorships, silent coding and debugging that requires extensive context.

Rules:
- George Hotz must be the main speaker throughout each clip. Skip segments dominated by hosts or other guests.
- Each clip covers one topic with a clear beginning and a natural end. Never cut mid-sentence or misrepresent an argument.
- STRICT MINIMUM 8 minutes, STRICT MAXIMUM 20 minutes; aim for 10-14 minutes. Do not pad weak material.
- Clips must not overlap. Score each 1-10 for standalone watch-time potential.
- Titles start with "George Hotz on" and name one concrete subject or supported claim, ideally under 65 characters. Never invent a claim or imply an old opinion is current.

Return JSON in this exact format:
{
  "clips": [
    {
      "title": "George Hotz on [short concrete subject]",
      "description": "Two or three accurate sentences explaining the argument and technologies discussed.",
      "start_ms": 12345,
      "end_ms": 67890,
      "score": 8,
      "thumbnail_prompt": "One simple bold object, symbol or scene representing the central idea. No names, faces or style instructions."
    }
  ]
}
"""

[channels.casey]
handle = "@caseymuratoriclips"
speaker = "Casey Muratori"
thumbnail_template = "casey.jpg"
category_id = "28"

description_template = """
{clip_description}

Clip from Casey Muratori
Original: {original_url}
Casey's work: https://caseymuratori.com/

#caseymuratori #programming #softwareperformance #gamedev
"""

clip_extraction_prompt_template = """
This is a transcript of an original long-form video featuring Casey Muratori, the programmer behind Handmade Hero and Computer, Enhance!.

Find strong standalone clips about programming, software performance, software design, clean code, object-oriented programming, C/C++, game engines, hardware, or learning to build software. Prefer one clear argument, a concrete explanation, or a demonstration that makes sense without the preceding talk or stream. Skip small talk, sponsorships, unrelated personal or political tangents, silent coding, and debugging that requires extensive context. Public talks, interviews and free streams are sources; paid course lessons are not.

Rules:
- Casey Muratori must be the main speaker. Skip segments dominated by hosts or other guests.
- Each clip covers one topic, starts at its beginning and ends naturally. Never cut mid-sentence or misrepresent an argument.
- STRICT MINIMUM 8 minutes, STRICT MAXIMUM 20 minutes; aim for 10-14 minutes. Do not pad weak material.
- Clips must not overlap. Score each 1-10 for standalone watch-time potential.
- Titles start with "Casey Muratori on" followed by one concrete subject or supported claim, ideally under 65 characters. Never invent a claim.

Return JSON in this exact format:
{
  "clips": [
    {
      "title": "Casey Muratori on [short concrete subject]",
      "description": "Two or three accurate sentences explaining the argument and technologies discussed.",
      "start_ms": 12345,
      "end_ms": 67890,
      "score": 8,
      "thumbnail_prompt": "One simple bold object, symbol or scene representing the central idea. No names, faces or style instructions."
    }
  ]
}
"""
