# YouTube Clip Automation Environment Variables
# Copy this file to .env and fill in your actual API keys

# AssemblyAI API Key for transcription
# Get yours at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# OpenRouter API Key for LLM clip extraction and image generation
# Get yours at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: FFmpeg path (defaults to /opt/homebrew/bin/ffmpeg)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Optional: Working directory for output files (defaults to /Users/aiden/repos/blow/output)
# YT_CLIP_WORK_DIR=/Users/aiden/repos/blow/output
